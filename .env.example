# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Recruiter Portal Authentication Credentials
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_secure_password_here

# Email SMTP Notification Configuration
SENDER_NAME=Your Name / Company Name
SENDER_EMAIL=your_email@gmail.com
# Google App Password (Generate at https://myaccount.google.com/apppasswords - requires 2FA)
SENDER_PW=your_gmail_app_password_here
